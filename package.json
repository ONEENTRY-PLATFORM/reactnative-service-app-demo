{
  "name": "beauty-service-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "pre-install": "yarn set version 4",
    "postinstall": "patch-package || echo 'patch-package deferred to eas-build-post-install'",
    "eas-build-pre-install": "corepack enable && corepack prepare yarn@4.9.2 --activate",
    "eas-build-post-install": "yarn patch-package",
    "lint": "eslint .",
    "fix-android-manifest": "node scripts/update-android-manifest.js"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo-google-fonts/lato": "^0.4.1",
    "@expo-google-fonts/league-gothic": "^0.4.2",
    "@expo/log-box": "57.0.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@reduxjs/toolkit": "^2.12.0",
    "dayjs": "^1.11.21",
    "expo": "~57.0.0",
    "expo-auth-session": "~57.0.5",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "formik": "^2.4.9",
    "lucide-react-native": "^1.27.0",
    "nativewind": "^4.2.6",
    "oneentry": "^1.0.156",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-collapsible": "^1.6.2",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mask-text": "^0.15.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.0",
    "react-native-reanimated-carousel": "^5.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.4.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "react-redux": "^9.3.0",
    "tailwindcss": "^3.4.19",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.10",
    "@types/react-dom": "^19",
    "eslint": "^9.36.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-element-dropdown",
          "oneentry"
        ]
      }
    }
  },
  "packageManager": "yarn@4.9.2"
}
